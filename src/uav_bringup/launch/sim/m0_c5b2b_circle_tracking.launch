<launch>
  <!--
    M0-C5B2B PX4 SITL-only circle tracking bringup.
    This launch starts only project-side ROS nodes. The guarded experiment
    script owns authorization, ground-hold publication, dynamic circle
    trajectory publication, OFFBOARD/arming service order, AUTO.LAND recovery,
    and process cleanup.
    It does not start PX4, MAVROS, arm, set mode, land, connect serial, or
    modify PX4 parameters.
  -->
  <arg name="allow_mavros_output" default="true" />
  <arg name="mavros_output_topic" default="/mavros/setpoint_raw/local" />
  <arg name="publish_rate_hz" default="30.0" />
  <arg name="preview_timeout_sec" default="1.0" />
  <arg name="state_timeout_sec" default="1.0" />

  <include file="$(find uav_bringup)/launch/sim/state_bridge_sitl.launch">
    <arg name="odom_timeout" value="$(arg state_timeout_sec)" />
  </include>

  <node pkg="uav_trajectory"
        type="trajectory_preview_node"
        name="trajectory_preview_node"
        output="screen">
    <rosparam command="load" file="$(find uav_trajectory)/config/trajectory_preview.yaml" />
    <param name="state_timeout" value="$(arg state_timeout_sec)" />
  </node>

  <node pkg="uav_offboard"
        type="offboard_adapter_node"
        name="offboard_adapter_node"
        output="screen">
    <rosparam command="load" file="$(find uav_offboard)/config/offboard_adapter_dry_run.yaml" />
    <param name="allow_mavros_output" value="$(arg allow_mavros_output)" />
    <param name="mavros_output_topic" value="$(arg mavros_output_topic)" />
    <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <param name="preview_timeout_sec" value="$(arg preview_timeout_sec)" />
    <param name="state_timeout_sec" value="$(arg state_timeout_sec)" />
  </node>
</launch>
